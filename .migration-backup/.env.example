# LoanMatters Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# REQUIRED FOR FULL FUNCTIONALITY
# ============================================

# Tavily API Key (for real-time web search)
# Get yours at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================
# OPTIONAL - Supabase (for blog & user auth)
# ============================================

# Supabase URL and Keys
# Get from: https://supabase.com/dashboard/project/[your-project]/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# OPTIONAL - AI Providers (choose one or more)
# Users can also enter API keys in the app UI
# ============================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Groq API Key
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# NOTES
# ============================================
# 
# For the Open Source / PWA version:
# - Users can enter their own API keys in the app Settings
# - Keys are stored locally in the browser (localStorage)
# - No server-side storage of user API keys
#
# For hosted deployment:
# - Set the above environment variables in your hosting platform
# - Vercel: Project Settings > Environment Variables
